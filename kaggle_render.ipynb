 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Audio Visualizer — Kaggle headless GPU render\n",
    "Notebook ini dibuat khusus untuk dijalankan sebagai Kaggle Kernel (Notebook).\n",
    "Petunjuk singkat: aktifkan Settings -> Accelerator -> GPU. Tambahkan dataset berisi audio + template ke "/kaggle/input/<dataset>" atau unggah file ke `/kaggle/working`. Jalankan sel berurutan. Output disimpan di /kaggle/working."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Clone repository (shallow)\n",
    "from pathlib import Path\n",
    "import shutil, subprocess, os, sys\n",
    "\n",
    "REPO_URL = 'https://github.com/Qodri588/av.git'\n",
    "BRANCH = 'master'\n",
    "project_root = Path('/kaggle/working/audio-visualizer')\n",
    "if project_root.exists():\n",
    "    shutil.rmtree(project_root)\n",
    "subprocess.run(['git', 'clone', '--depth', '1', '--branch', BRANCH, REPO_URL, str(project_root)], check=True)\n",
    "project = project_root\n",
    "print('Project cloned to', project)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Install system packages and Python requirements.\n",
    "# Note: Kaggle already provides CUDA and NVIDIA drivers when GPU is enabled.\n",
    "!apt-get -qq update\n",
    "!apt-get -qq install -y ffmpeg libegl1 libegl-mesa0 libgl1-mesa-dri\n",
    "!pip -q install -r \"{project / 'requirements-colab.txt'}\"\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Detect NVIDIA GPU and prepare GL environment for headless rendering\n",
    "import os, subprocess, sys\n",
    "USE_GPU = False\n",
    "try:\n",
    "    r = subprocess.run(['nvidia-smi', '--query-gpu=name', '--format=csv,noheader'], capture_output=True, text=True, check=False)\n",
    "    if r.returncode == 0 and r.stdout.strip():\n",
    "        print('NVIDIA GPU detected:', r.stdout.strip())\n",
    "        USE_GPU = True\n",
    "    else:\n",
    "        print('nvidia-smi not available or no GPU found; will fallback to Mesa')\n",
    "except FileNotFoundError:\n",
    "    print('nvidia-smi not found; running without GPU')\n",
    "\n",
    "render_env = os.environ.copy()\n",
    "render_env['MGL_BACKEND'] = 'egl'\n",
    "if USE_GPU:\n",
    "    render_env.pop('LIBGL_ALWAYS_SOFTWARE', None)\n",
    "    print('Render mode: hardware GPU (EGL)')\n",
    "else:\n",
    "    render_env['LIBGL_ALWAYS_SOFTWARE'] = '1'\n",
    "    print('Render mode: CPU (Mesa software)')\n",
    "\n",
    "# Probe moderngl (best-effort) to show vendor/renderer info\n",
    "probe = subprocess.run([sys.executable, '-c',\n",
    "    \"import moderngl; c=moderngl.create_standalone_context(backend='egl'); print(c.info.get('GL_VENDOR')); print(c.info.get('GL_RENDERER')); c.release()\"],\n",
    "    env=render_env, text=True, capture_output=True, check=False)\n",
    "print('Probe stdout:\n', probe.stdout)\n",
    "print('Probe stderr:\n', probe.stderr)\n",
    "# Keep render_env available for later cells\n",
    "_RENDER_ENV = render_env\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Locate input files in /kaggle/input or /kaggle/working\n",
    "from pathlib import Path\n",
    "input_dirs = list(Path('/kaggle/input').glob('*')) if Path('/kaggle/input').exists() else []\n",
    "print('Datasets found in /kaggle/input:', [p.name for p in input_dirs])\n",
    "\n",
    "# You can set these variables manually or place files in /kaggle/input/<dataset>/\n",
    "USE_EXAMPLE_TEMPLATE = False\n",
    "TEMPLATE = ''  # e.g. 'template.json'\n",
    "AUDIO = ''     # e.g. 'song.mp3'\n",
    "BACKGROUND = ''\n",
    "CENTER = ''\n",
    "OUTPUT = 'hasil-render.mp4'\n",
    "RESOLUTION = '1080p'  # Kaggle GPU can handle higher resolutions, but watch limits\n",
    "FPS = 30\n",
    "SUPERSAMPLING = 1\n",
    "TEST_SECONDS = 10  # None -> full audio\n",
    "\n",
    "# helper to find first matching file in working or input datasets\n",
    "def first_with(suffixes):\n",
    "    # search /kaggle/working then /kaggle/input/*\n",
    "    w = Path('/kaggle/working')\n",
    "    for p in w.iterdir():\n",
    "        if p.suffix.lower() in suffixes:\n",
    "            return p\n",
    "    for ds in input_dirs:\n",
    "        for p in ds.rglob('*'):\n",
    "            if p.suffix.lower() in suffixes:\n",
    "                return p\n",
    "    return None\n",
    "\n",
    "upload_template = project / 'coba' / 'temp.json' if USE_EXAMPLE_TEMPLATE else (Path('/kaggle/working') / TEMPLATE if TEMPLATE else first_with({'.json','.yaml','.yml','.toml'}))\n",
    "upload_audio = (Path('/kaggle/working') / AUDIO) if AUDIO else first_with({'.wav','.flac','.mp3','.ogg','.aiff','.aif','.m4a'})\n",
    "if not upload_template or not upload_template.is_file():\n",
    "    raise FileNotFoundError('Template not found. Place template.json in /kaggle/working or add a dataset to /kaggle/input')\n",
    "if not upload_audio or not upload_audio.is_file():\n",
    "    raise FileNotFoundError('Audio not found. Place audio file in /kaggle/working or add a dataset to /kaggle/input')\n",
    "print('Using template:', upload_template)\n",
    "print('Using audio:', upload_audio)\n",
    "# expose for next cell\n",
    "_TEMPLATE = upload_template\n",
    "_AUDIO = upload_audio\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run the renderer (main.py) and write output to /kaggle/working\n",
    "import subprocess, os\n",
    "output = Path('/kaggle/working') / OUTPUT\n",
    "cmd = ['python', str(project/'main.py'), '--cli', str(_TEMPLATE), str(_AUDIO), '--resolution', RESOLUTION, '--fps', str(FPS), '--supersampling', str(SUPERSAMPLING), '-o', str(output)]\n",
    "if TEST_SECONDS is not None: cmd += ['--duration', str(TEST_SECONDS)]\n",
    "if BACKGROUND: cmd += ['--bg', str(Path('/kaggle/working')/BACKGROUND)]\n",
    "if CENTER: cmd += ['--center', str(Path('/kaggle/working')/CENTER)]\n",
    "env = _RENDER_ENV.copy()\n",
    "env['PYTHONPATH'] = str(project)\n",
    "print('Running:', ' '.join(cmd))\n",
    "subprocess.run(cmd, cwd=project, env=env, check=True)\n",
    "print('Rendered output saved to', output)\n"
   ]
  }
 ],
